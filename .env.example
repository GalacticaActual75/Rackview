# Copy these settings to the Arcane project's .env before Build & Deploy.
# Use a prepared absolute host path, or leave blank for a Docker volume.
RACKVIEW_DATA_SOURCE=

# Set both for a custom dashboard login. Blank values use the generated login.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Optional host port and bind address.
RACKVIEW_PORT=8080
RACKVIEW_BIND=
