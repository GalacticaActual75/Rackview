# Copy these settings to the Arcane project's .env before Build & Deploy.
# Use a prepared absolute host path, or leave blank for a Docker volume.
# TrueNAS example: RACKVIEW_DATA_SOURCE=/mnt/tank/apps/rackview
RACKVIEW_DATA_SOURCE=

# Rackview defaults to admin / admin. Set these to use your own login.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=admin

# Optional host port and bind address.
RACKVIEW_PORT=8080
RACKVIEW_BIND=
